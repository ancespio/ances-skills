{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-editable-pptx/asset-plan.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "items"],
  "properties": {
    "schema_version": {"const": "craft-editable-pptx.asset-plan.v1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["draft", "awaiting_user", "confirmed"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pages", "purpose", "asset_type", "source", "contains_semantic_text"],
        "properties": {
          "id": {"type": "string"},
          "pages": {"type": "array", "items": {"type": "string"}},
          "purpose": {"type": "string"},
          "asset_type": {"enum": ["svg", "raster", "native"]},
          "source": {"type": "string"},
          "contains_semantic_text": {"type": "boolean"}
        }
      }
    }
  }
}
