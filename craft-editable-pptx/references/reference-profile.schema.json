{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-editable-pptx/reference-profile.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "primary_reference", "references", "design_rules"],
  "properties": {
    "schema_version": {"const": "craft-editable-pptx.reference-profile.v1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["draft", "awaiting_user", "confirmed", "blocked"]},
    "primary_reference": {"type": "string", "minLength": 1},
    "references": {"type": "array", "minItems": 1},
    "design_rules": {"type": "object"}
  }
}
