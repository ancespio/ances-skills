{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-editable-pptx/outline.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "slides"],
  "properties": {
    "schema_version": {"const": "craft-editable-pptx.outline.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "awaiting_user", "confirmed", "blocked"]},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "key_message", "audience_move", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "key_message": {"type": "string", "minLength": 1},
          "audience_move": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
