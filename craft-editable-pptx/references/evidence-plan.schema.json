{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-editable-pptx/evidence-plan.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "items"],
  "properties": {
    "schema_version": {"const": "craft-editable-pptx.evidence-plan.v1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["draft", "awaiting_user", "confirmed"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "source", "included"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "source": {"type": "string"},
          "included": {"type": "boolean"}
        }
      }
    }
  }
}
