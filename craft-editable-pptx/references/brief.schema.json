{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-editable-pptx/brief.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "scenario", "status", "audience", "objective", "success_criteria", "source_policy", "constraints"],
  "properties": {
    "schema_version": {"const": "craft-editable-pptx.brief.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"enum": ["new-deck", "template-fill", "reconstruction", "reference-deck", "existing-deck"]},
    "status": {"enum": ["draft", "awaiting_user", "confirmed", "blocked"]},
    "audience": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_policy": {"type": "object"},
    "constraints": {"type": "object"}
  },
  "additionalProperties": true
}
