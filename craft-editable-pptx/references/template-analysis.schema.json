{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-editable-pptx/template-analysis.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "template_kind", "preserve", "slide_families", "ambiguous_texts", "missing_fonts"],
  "properties": {
    "schema_version": {"const": "craft-editable-pptx.template-analysis.v1"},
    "run_id": {"type": "string"},
    "status": {"enum": ["draft", "awaiting_user", "confirmed", "blocked"]},
    "template_kind": {"enum": ["placeholder-based", "framework-only", "mixed"]},
    "preserve": {"type": "array", "items": {"type": "string"}},
    "slide_families": {"type": "array", "minItems": 1},
    "ambiguous_texts": {"type": "array"},
    "missing_fonts": {"type": "array", "items": {"type": "string"}}
  }
}
