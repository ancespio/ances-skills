{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "craft-editable-pptx/pptx-artifacts.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "craft-editable-pptx.pptx-artifacts.v1"},
    "run_id": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "path", "sha256", "qa_path", "expected_pages", "reusable", "parents"],
        "properties": {
          "id": {"type": "string"},
          "purpose": {"enum": ["layout-preview", "style-option-a", "style-option-b", "style-option-c", "template-representatives", "reconstruction-prototypes", "reference-representatives", "change-preview", "final-output"]},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "qa_path": {"type": "string"},
          "expected_pages": {"type": "integer", "minimum": 1},
          "reusable": {"type": "boolean"},
          "parents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
