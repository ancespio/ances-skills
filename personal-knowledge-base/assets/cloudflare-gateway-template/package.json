{
  "name": "knowledgebase-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm cf:types && pnpm cf:types:mcp && vitest run && tsc --noEmit",
    "cf:types": "wrangler types",
    "cf:types:mcp": "wrangler types mcp-configuration.d.ts --env-interface McpBindings --include-runtime false --strict-vars false -c wrangler.mcp.jsonc && node scripts/isolate-mcp-types.mjs",
    "deploy:mcp:dry": "wrangler deploy --dry-run -c wrangler.mcp.jsonc",
    "deploy:mcp": "wrangler deploy -c wrangler.mcp.jsonc",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.109.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
