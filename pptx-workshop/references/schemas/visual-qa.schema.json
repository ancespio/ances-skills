{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pptx-workshop/visual-qa.schema.json",
  "type": "object",
  "required": ["schema_version", "artifact_id", "pptx_path", "pptx_sha256", "render_dir", "rendered_pages", "inspected_pages", "inspected_by", "status", "checks", "issues"],
  "properties": {
    "schema_version": {"const": "pptx-workshop.visual-qa.v1"},
    "artifact_id": {"type": "string"},
    "pptx_path": {"type": "string"},
    "pptx_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "render_dir": {"type": "string"},
    "rendered_pages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inspected_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "inspected_by": {"enum": ["agent", "user"]},
    "status": {"enum": ["pass", "fail"]},
    "checks": {"type": "object"},
    "issues": {"type": "array"},
    "diagnostics": {"type": "array"}
  }
}
