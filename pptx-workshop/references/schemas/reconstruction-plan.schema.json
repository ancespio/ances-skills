{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pptx-workshop/reconstruction-plan.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "source_locked", "visual_asset_policy", "slides", "uncertain_text"],
  "properties": {
    "schema_version": {"const": "pptx-workshop.reconstruction-plan.v3"},
    "run_id": {"type": "string"},
    "status": {"enum": ["draft", "awaiting_user", "confirmed", "blocked"]},
    "source_locked": {"const": true},
    "visual_asset_policy": {"enum": ["fidelity-first-controlled-png", "gorden-original"]},
    "execution_mode": {"enum": ["gorden-original", "parent-managed"]},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_page", "source_image", "ref_width", "ref_height", "objects"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
          "source_page": {"type": "integer", "minimum": 1},
          "source_image": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          },
          "ref_width": {"type": "integer", "minimum": 1},
          "ref_height": {"type": "integer", "minimum": 1},
          "objects": {"type": "array", "minItems": 1}
        }
      }
    },
    "uncertain_text": {"type": "array"}
  }
}
