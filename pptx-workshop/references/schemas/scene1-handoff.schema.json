{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pptx-workshop/scene1-handoff.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "upstream_run_id", "upstream_project", "upstream_artifact_manifest", "upstream_asset_plan", "upstream_final_pptx", "upstream_image_deck_approval", "pages"],
  "properties": {
    "schema_version": {"const": "pptx-workshop.scene1-handoff.v2"},
    "run_id": {"type": "string"},
    "status": {"enum": ["draft", "awaiting_user", "confirmed"]},
    "upstream_run_id": {"type": "string", "minLength": 1},
    "upstream_project": {"$ref": "#/$defs/file"},
    "upstream_artifact_manifest": {"$ref": "#/$defs/file"},
    "upstream_asset_plan": {"$ref": "#/$defs/file"},
    "upstream_final_pptx": {"$ref": "#/$defs/file"},
    "upstream_image_deck_approval": {"$ref": "#/$defs/file"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/file"},
          {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "pattern": "^P[0-9]{2,3}$"}}}
        ]
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
