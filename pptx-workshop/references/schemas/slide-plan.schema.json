{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pptx-workshop/slide-plan.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "slides"],
  "properties": {
    "schema_version": {"const": "pptx-workshop.slide-plan.v3"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "awaiting_user", "confirmed", "blocked"]},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text_locked",
          "layout_locked",
          "content_blocks",
          "layout",
          "asset_ids",
          "native_objects",
          "qa_assertions"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]{2,3}$"},
          "text_locked": {"const": true},
          "layout_locked": {"const": true},
          "content_blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "text", "bbox", "reading_order", "align"],
              "properties": {
                "id": {"type": "string", "pattern": "^B[0-9]{2,3}$"},
                "type": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "bbox": {
                  "type": "array",
                  "prefixItems": [
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "minimum": 0, "maximum": 1},
                    {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                    {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                "reading_order": {"type": "integer", "minimum": 1},
                "align": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "layout": {
            "type": "object",
            "required": ["pattern", "reading_order", "decorative_safe_zones"],
            "properties": {
              "pattern": {"type": "string", "minLength": 1},
              "reading_order": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^B[0-9]{2,3}$"}
              },
              "decorative_safe_zones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "bbox", "purpose"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "bbox": {
                      "type": "array",
                      "prefixItems": [
                        {"type": "number", "minimum": 0, "maximum": 1},
                        {"type": "number", "minimum": 0, "maximum": 1},
                        {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                        {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                      ],
                      "items": false,
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "purpose": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          },
          "asset_ids": {"type": "array", "items": {"type": "string"}},
          "native_objects": {"type": "array", "items": {"type": "string"}},
          "qa_assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
